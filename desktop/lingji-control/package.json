{
  "name": "lingji-control-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test:inspector": "tsx scripts/memory-inspector-smoke.mjs",
    "test:capture": "tsx scripts/capture-center-smoke.mjs",
    "test:drama": "tsx scripts/drama-memory-smoke.mjs",
    "test:codex-loop": "tsx scripts/codex-workspace-smoke.mjs",
    "test:memory-review": "tsx scripts/memory-review-smoke.mjs",
    "test:obsidian-operations": "tsx scripts/obsidian-operations-smoke.mjs",
    "test:release": "tsx scripts/windows-release-smoke.mjs",
    "test:runtime": "tsx scripts/runtime-sidecar-smoke.mjs",
    "test:smoke": "tsx scripts/run-smoke-suite.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "build:sidecar:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build_windows_sidecar.ps1",
    "release:windows": "npm run build:sidecar:windows && tauri build --config src-tauri/tauri.sidecar.conf.json --bundles nsis --target x86_64-pc-windows-msvc",
    "test:obsidian": "tsx scripts/obsidian-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tsx": "4.23.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
